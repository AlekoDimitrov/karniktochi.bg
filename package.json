{
  "name": "karniktochi",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-hidden.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types --strict-vars=false",
    "seed:dev": "wrangler d1 execute karniktochi --local --file scripts/seed-dev.sql",
    "seed:orders": "wrangler d1 execute karniktochi --local --file scripts/seed-orders.sql",
    "unseed:orders": "wrangler d1 execute karniktochi --local --file scripts/unseed-orders.sql",
    "test": "vitest run",
    "check:admin-paths": "node scripts/check-admin-paths.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "astro": "^7.4.2",
    "jose": "^6.2.13",
    "wrangler": "^4.153.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "miniflare": "^5.20261023.0-beta",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
