# build output
dist/
# generated types
.astro/

# dependencies (no trailing slash, so a symlinked node_modules in a worktree is ignored too)
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler local state
.wrangler/

# local Worker secrets
.dev.vars

# database backups are never kept in the repo (migrations/*.sql stay tracked)
backup*.sql
