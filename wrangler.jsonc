{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "karniktochi",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "karniktochi",
			// Replace with the id printed by `npx wrangler d1 create karniktochi`.
			"database_id": "1e85b95d-2f5b-4ea9-a6ef-d326b25f176c",
			"migrations_dir": "migrations"
		}
	],
	"secrets": {
		"required": ["RESEND_API_KEY"]
	},
	// Plain settings. Secrets (RESEND_API_KEY) are set with `npx wrangler secret put` and `.dev.vars` locally.
	"vars": {
		// "true" offers bank transfer at checkout and shows the bank details below. Anything else turns it off.
		"ENABLE_BANK_TRANSFER": "false",
		"BANK_IBAN": "",
		"BANK_BIC": "",
		"BANK_HOLDER": "",
		// Where new-order notifications go.
		"SHOP_NOTIFY_EMAIL": "team@karniktochi.com",
		// Sender for all emails. The domain must be verified in Resend.
		"EMAIL_FROM": "Карник Точи <porachki@karniktochi.com>",
		// Cloudflare Access (protects /admin): team domain like "yourteam.cloudflareaccess.com" and the app's AUD tag.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	}
}
