{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "karniktochi",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Workers Cache in front of the Worker (needs Wrangler 4.69.0+). What may be cached and for how long is set
	// per response with Cache-Control in src/lib/cache-policy.ts; admin saves purge by Cache-Tag.
	"cache": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "karniktochi",
			// Replace with the id printed by `npx wrangler d1 create karniktochi`.
			"database_id": "1e85b95d-2f5b-4ea9-a6ef-d326b25f176c",
			"migrations_dir": "migrations"
		}
	],
	// Product photos (src/lib/photos.ts). Customers load them from MEDIA_BASE_URL, never through the Worker.
	// Local dev uses wrangler's local R2 simulation only. The bucket isn't created on Cloudflare yet, so a
	// deploy fails until it is; no production deploy before media.karniktochi.com exists (DECISIONS).
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "karniktochi-media"
		}
	],
	"secrets": {
		"required": ["RESEND_API_KEY"]
	},
	// Plain settings. Secrets (RESEND_API_KEY) are set with `npx wrangler secret put` and `.dev.vars` locally.
	"vars": {
		// "true" offers bank transfer at checkout and shows the bank details below. Anything else turns it off.
		"ENABLE_BANK_TRANSFER": "false",
		"BANK_IBAN": "",
		"BANK_BIC": "",
		"BANK_HOLDER": "",
		// Where new-order notifications go.
		"SHOP_NOTIFY_EMAIL": "team@karniktochi.com",
		// Sender for all emails. The domain must be verified in Resend.
		"EMAIL_FROM": "Карник Точи <porachki@karniktochi.com>",
		// Cloudflare Access (protects /admin): team domain like "yourteam.cloudflareaccess.com" and the app's AUD tag.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		// Where customers load product photos from: the bucket's custom domain, without a trailing slash.
		// `astro dev` uses /dev-media instead, served from the local bucket (src/lib/media-base.ts).
		"MEDIA_BASE_URL": "https://media.karniktochi.com"
	},
	// Staging: a separate Worker (karniktochi-staging) at https://staging.karniktochi.com, with its own database
	// and bucket, so it never touches production data (DECISIONS 2026-10-30, 2026-11-25). Build and deploy with
	//   CLOUDFLARE_ENV=staging npm run build && npx wrangler deploy
	// (the build picks the environment; wrangler deploy then uses the config the build wrote).
	// Wrangler doesn't copy vars, secrets, d1_databases or r2_buckets into an environment, so they are
	// repeated here in full; assets, observability and cache are inherited.
	"env": {
		"staging": {
			// The deploy attaches this custom domain (and creates its DNS record). No workers.dev address:
			// Cloudflare Access protects /admin only on staging.karniktochi.com.
			"routes": [{ "pattern": "staging.karniktochi.com", "custom_domain": true }],
			"workers_dev": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "karniktochi-staging",
					"database_id": "64a85747-ebc3-4524-bb6c-6189bdc7ad98",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "karniktochi-media-staging"
				}
			],
			"secrets": {
				"required": ["RESEND_API_KEY"]
			},
			"vars": {
				"ENABLE_BANK_TRANSFER": "false",
				"BANK_IBAN": "",
				"BANK_BIC": "",
				"BANK_HOLDER": "",
				"SHOP_NOTIFY_EMAIL": "team@karniktochi.com",
				"EMAIL_FROM": "Карник Точи <porachki@karniktochi.com>",
				// The Access application "Karnik Tochi staging admin" (staging.karniktochi.com/admin).
				"ACCESS_TEAM_DOMAIN": "karniktochi.cloudflareaccess.com",
				"ACCESS_AUD": "1981c468e95a1514943b5b441d2cc021eda71c8661bb541bc718a541d1c74be0",
				// The custom domain on bucket karniktochi-media-staging (its r2.dev address is off).
				"MEDIA_BASE_URL": "https://media-staging.karniktochi.com"
			}
		}
	}
}
