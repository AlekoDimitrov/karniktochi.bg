---
import '@fontsource-variable/golos-text/wght.css';
import '../styles/global.css';

interface Props { title: string; active: 'orders' | 'products' }
const { title, active } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body>
    <header class="admin-bar">
      <strong>Karnik Tochi · Admin</strong>
      <nav>
        <a href="/admin/" aria-current={active === 'orders' ? 'page' : undefined}>Orders</a>
        <a href="/admin/products/" aria-current={active === 'products' ? 'page' : undefined}>Products</a>        <a href="/">View site</a>
      </nav>
    </header>
    <main class="admin"><slot /></main>
  </body>
</html>
