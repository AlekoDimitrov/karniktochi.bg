---
import '@fontsource-variable/golos-text/wght.css';
import '../styles/global.css';

interface Props { title: string; active: 'orders' | 'stock' }
const { title, active } = Astro.props;
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Админ</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body>
    <header class="admin-bar">
      <strong>Карник Точи · Админ</strong>
      <nav>
        <a href="/admin/" aria-current={active === 'orders' ? 'page' : undefined}>Поръчки</a>
        <a href="/admin/stock/" aria-current={active === 'stock' ? 'page' : undefined}>Наличност</a>
        <a href="/">Към сайта</a>
      </nav>
    </header>
    <main class="admin"><slot /></main>
  </body>
</html>
