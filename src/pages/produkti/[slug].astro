---
import Layout from '../../layouts/Layout.astro';
import ProductView from '../../components/ProductView.astro';
import { bg } from '../../i18n/bg';
import { cacheTagHeader, tags } from '../../lib/cache-policy';
import { getProductPageData } from '../../lib/products';

export const prerender = false;

// One D1 batch gives the product, its other models and the related products.
const data = await getProductPageData(Astro.params.slug ?? '');
if (!data) return Astro.rewrite('/404');
const { product: d, otherModels, related } = data;
// Saving any product shown here purges this page (see cache-purge.ts).
Astro.response.headers.set('Cache-Tag', cacheTagHeader([d, ...otherModels, ...related].map((p) => tags.product(p.id))));
---
<Layout title={`${d.name} — ${bg.siteName}`} description={d.summary} active="shop">
  <ProductView data={data} />
</Layout>
