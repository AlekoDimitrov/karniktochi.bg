---
import Layout from '../../layouts/Layout.astro';
import { bg } from '../../i18n/bg';

// Rendered per request but never cached; the lines come from /api/cart-lines in the browser.
export const prerender = false;

const t = bg.cart;
---
<Layout title={`${t.title} — ${bg.siteName}`} active="cart">
  <div class="container narrow">
    <h1 class="page-h1">{t.title}</h1>
    <div data-cart-root>
      <p class="form-error" data-cart-error role="alert" hidden>{t.loadFailed}</p>
      <p data-cart-empty hidden>
        {t.empty} <a class="link-orange" href="/produkti/">{t.browse} →</a>
      </p>
      <ul class="cart-lines" data-cart-lines></ul>
      <div class="cart-total" data-cart-summary hidden>
        <div class="cart-total__row"><span>{t.total}</span><strong data-cart-total></strong></div>
        <small>{t.shippingNote}</small>
        <div class="cart-fixed" data-cart-fixed role="status" hidden></div>
        <div class="cart-blocked" data-cart-blocked hidden>
          <p class="form-error" id="cart-blocked-msg">{t.blocked}</p>
          <button type="button" class="btn btn--outline" data-cart-fix>{t.fix}</button>
        </div>
        <a class="btn btn--add" href="/porachka/" data-checkout-link>{t.checkout}</a>
      </div>
    </div>
  </div>

  <template id="cart-line">
    <li class="cart-line">
      <div class="cart-line__photo"><img alt="" width="80" height="100" /></div>
      <div class="cart-line__info">
        <span class="card__brand" data-brand></span>
        <a class="cart-line__name" data-name></a>
        <small class="cart-line__option" data-option hidden></small>
        <span class="cart-line__price" data-price></span>
        <small class="cart-line__warn" data-warn hidden></small>
      </div>
      <div class="cart-line__qty">
        <label>
          <span class="visually-hidden">{t.qty}</span>
          <input type="number" min="1" inputmode="numeric" data-qty />
        </label>
        <button type="button" class="link-btn" data-remove>{t.remove}</button>
      </div>
    </li>
  </template>
  <script type="application/json" id="cart-text" set:html={JSON.stringify(t)} />
</Layout>

<script>
  import { onCartChange, readCart, removeFromCart, setCart, setQty, type CartLine } from '../../scripts/cart';
  import { fetchCartLines, type CartLines } from '../../scripts/cart-lines';
  import { cartProblems, cartScreen, fixCart, limitQty } from '../../lib/cart-stock';
  import { formatPrice } from '../../lib/format';

  // Details for the variants in the cart, with live stock. Filled from /api/cart-lines.
  let catalog: CartLines = {};
  const t = JSON.parse(document.getElementById('cart-text')!.textContent!);
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const list = $('[data-cart-lines]');
  const tpl = $<HTMLTemplateElement>('#cart-line');
  const empty = $('[data-cart-empty]');
  const summary = $('[data-cart-summary]');
  const totalEl = $('[data-cart-total]');
  const blocked = $('[data-cart-blocked]');
  const fixedEl = $('[data-cart-fixed]');
  const checkoutLink = $<HTMLAnchorElement>('[data-checkout-link]');
  const errorEl = $('[data-cart-error]');

  // Shows or hides the parts of the page; after a failed load nothing stale (lines, total, checkout) stays.
  const show = (lineCount: number, load: 'pending' | 'failed' | 'loaded') => {
    const s = cartScreen(lineCount, load);
    errorEl.hidden = !s.error;
    list.hidden = !s.lines;
    if (!s.lines) list.replaceChildren();
    summary.hidden = !s.summary;
    empty.hidden = !s.empty;
  };

  // Available count per variant that can still be ordered.
  const stock = (): Record<string, number> =>
    Object.fromEntries(Object.values(catalog).map((p) => [p.id, p.stock]));
  // Lines whose typed quantity was lowered to the stock, with that stock, so the line says why.
  const lowered = new Map<string, number>();
  // Name of a line in messages: its current details, else the title saved when it was added.
  const nameOf = (line: CartLine) => {
    const p = catalog[line.id];
    return p ? [p.name, p.option].filter(Boolean).join(', ') : (line.title ?? t.unknownProduct);
  };

  // While the cart has problems the checkout link stays focusable but does nothing.
  checkoutLink.addEventListener('click', (e) => {
    if (checkoutLink.getAttribute('aria-disabled') === 'true') e.preventDefault();
  });

  const render = (lines: CartLine[]) => {
    list.replaceChildren();
    const problems = new Map(cartProblems(lines, stock()).map((p) => [p.id, p]));
    let total = 0;
    for (const line of lines) {
      const p = catalog[line.id];
      const problem = problems.get(line.id);
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const q = <T extends Element>(s: string) => li.querySelector<T>(s)!;
      const img = q<HTMLImageElement>('img');
      const warn = q<HTMLElement>('[data-warn]');
      const qty = q<HTMLInputElement>('[data-qty]');
      q<HTMLButtonElement>('[data-remove]').addEventListener('click', () => removeFromCart(line.id));
      if (!p) {
        img.remove();
        q('[data-name]').textContent = nameOf(line);
        warn.textContent = t.unavailable;
        warn.hidden = false;
        qty.closest('label')!.remove();
        list.appendChild(li);
        continue;
      }
      if (p.photo) img.src = p.photo;
      else img.remove();
      q('[data-brand]').textContent = p.brand.toUpperCase();
      const name = q<HTMLAnchorElement>('[data-name]');
      name.textContent = p.name;
      name.href = p.url;
      const option = q<HTMLElement>('[data-option]');
      option.textContent = p.option;
      option.hidden = !p.option;
      q('[data-price]').textContent = formatPrice(p.priceCents * line.qty);
      qty.value = String(line.qty);
      if (p.stock > 0) qty.max = String(p.stock);
      else qty.disabled = true;
      if (problem?.kind === 'soldOut') warn.textContent = t.soldOut;
      if (problem?.kind === 'over') warn.textContent = t.overStock.replace('{n}', String(problem.available));
      if (!problem && lowered.has(line.id)) warn.textContent = t.lowered.replaceAll('{n}', String(lowered.get(line.id)));
      warn.hidden = !warn.textContent;
      qty.addEventListener('change', () => {
        const n = Math.floor(Number(qty.value));
        lowered.delete(line.id);
        if (n > 0) {
          const limited = limitQty(n, p.stock);
          if (limited.lowered) lowered.set(line.id, limited.qty);
          setQty(line.id, limited.qty);
        } else removeFromCart(line.id);
      });
      total += p.priceCents * line.qty;
      list.appendChild(li);
    }
    show(lines.length, 'loaded');
    totalEl.textContent = formatPrice(total);

    const isBlocked = problems.size > 0;
    blocked.hidden = !isBlocked;
    if (isBlocked) {
      checkoutLink.setAttribute('aria-disabled', 'true');
      checkoutLink.setAttribute('aria-describedby', 'cart-blocked-msg');
    } else {
      checkoutLink.removeAttribute('aria-disabled');
      checkoutLink.removeAttribute('aria-describedby');
    }
  };

  $('[data-cart-fix]').addEventListener('click', () => {
    const before = readCart();
    const { lines, fixed } = fixCart(before, stock());
    const items = fixed.map((f) => {
      const name = nameOf(before.find((l) => l.id === f.id)!);
      const li = document.createElement('li');
      li.textContent =
        f.kind === 'over'
          ? t.fixedLowered.replace('{name}', name).replace('{from}', String(f.qty)).replace('{to}', String(f.available))
          : (f.kind === 'soldOut' ? t.fixedRemoved : t.fixedUnavailable).replace('{name}', name);
      return li;
    });
    const title = document.createElement('strong');
    title.textContent = t.fixedTitle;
    const ul = document.createElement('ul');
    items.forEach((li) => ul.appendChild(li));
    fixedEl.replaceChildren();
    fixedEl.appendChild(title);
    fixedEl.appendChild(ul);
    fixedEl.hidden = items.length === 0;
    setCart(lines);
    // Move focus somewhere sensible: the fix button disappears once the cart is fixed.
    (lines.length ? checkoutLink : $<HTMLAnchorElement>('[data-cart-empty] a')).focus();
  });

  // Ask for the variants in the cart (again only when a line appears that hasn't been asked about, e.g.
  // added in another tab), then draw. Until the first answer the page shows nothing; an empty cart
  // needs no request and shows the empty state right away.
  const asked = new Set<string>();
  onCartChange(async (lines) => {
    const missing = lines.map((l) => l.id).filter((id) => !asked.has(id));
    if (missing.length) {
      const got = await fetchCartLines(missing);
      if (!got) {
        show(lines.length, 'failed');
        return;
      }
      missing.forEach((id) => asked.add(id));
      catalog = { ...catalog, ...got };
    }
    render(readCart());
  });
</script>
