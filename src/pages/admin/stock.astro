---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllProducts, optionText } from '../../lib/catalog';
import { getStockLevels, setStock } from '../../lib/orders';

export const prerender = false;

// Every variant of every product, in any status.
const rows = (await listAllProducts(env.DB)).flatMap((p) =>
  p.variants.map((v) => ({ id: v.id, title: [p.brand, p.name, optionText(p.optionLabel, v.optionValue)].filter(Boolean).join(' ') })),
);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id'));
  const qty = Number(form.get('quantity'));
  if (rows.some((r) => r.id === id) && Number.isInteger(qty) && qty >= 0 && qty <= 100000) await setStock(env.DB, id, qty);
  return Astro.redirect(`/admin/stock/?saved=${encodeURIComponent(id)}#p-${id}`, 303);
}

const levels = await getStockLevels(env.DB, {});
const saved = Astro.url.searchParams.get('saved');
---
<AdminLayout title="Наличност" active="stock">
  <h1 class="page-h1">Наличност</h1>
  <p class="muted" style="max-width: 640px">
    Броят тук е актуалната наличност на всеки вариант: поръчките я намаляват, а отказаните и анулираните я връщат.
    При нова доставка въведете новия общ брой тук.
  </p>
  <table class="stock-table">
    <thead><tr><th>Продукт</th><th>Наличност</th></tr></thead>
    <tbody>
      {rows.map((p) => (
        <tr id={`p-${p.id}`}>
          <td>{p.title}</td>
          <td>
            <form method="post" class="stock-form">
              <input type="hidden" name="id" value={p.id} />
              <input type="number" name="quantity" min="0" max="100000" value={levels[p.id] ?? 0} aria-label={`Наличност за ${p.title}`} />
              <button class="btn btn--accent" type="submit">Запази</button>
              {saved === p.id && <span role="status">Записано.</span>}
            </form>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
