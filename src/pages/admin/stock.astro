---
import * as workers from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllProducts, optionText, variantProductId } from '../../lib/catalog';
import { purgeTags, stockPurgeTags } from '../../lib/cache-purge';
import { getStockLevels, MAX_STOCK, parseStockQuantity, setStock } from '../../lib/orders';

export const prerender = false;

const { env } = workers;
// Workers Cache's purge API. Local wrangler dev / astro dev export a `cache` without purge(); there (and in
// any runtime without it) saving just skips purging.
const purger = typeof (workers as { cache?: { purge?: unknown } }).cache?.purge === 'function' ? workers.cache : undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id'));
  // An empty, negative, fractional or too large value saves nothing (an empty field is not 0).
  const qty = parseStockQuantity(form.get('quantity'));
  const productId = await variantProductId(env.DB, id);
  if (!productId || qty === null) {
    return Astro.redirect(`/admin/stock/?invalid=${encodeURIComponent(id)}#p-${id}`, 303);
  }
  await setStock(env.DB, id, qty);
  // Cached pages and /api/stock show the new count right away instead of after max-age.
  await purgeTags(purger, stockPurgeTags(productId));
  return Astro.redirect(`/admin/stock/?saved=${encodeURIComponent(id)}#p-${id}`, 303);
}

// Every variant of every product, in any status.
const rows = (await listAllProducts(env.DB)).flatMap((p) =>
  p.variants.map((v) => ({ id: v.id, title: [p.brand, p.name, optionText(p.optionLabel, v.optionValue)].filter(Boolean).join(' ') })),
);

const levels = await getStockLevels(env.DB, {});
const saved = Astro.url.searchParams.get('saved');
const invalid = Astro.url.searchParams.get('invalid');
---
<AdminLayout title="Stock" active="stock">
  <h1 class="page-h1">Stock</h1>
  <p class="muted" style="max-width: 640px">
    The number here is each variant's live stock: orders lower it, and cancelled or refused orders return it.
    When new stock arrives, enter the new total here.
  </p>
  <table class="stock-table">
    <thead><tr><th>Product</th><th>Stock</th></tr></thead>
    <tbody>
      {rows.map((p) => (
        <tr id={`p-${p.id}`}>
          <td>{p.title}</td>
          <td>
            <form method="post" class="stock-form">
              <input type="hidden" name="id" value={p.id} />
              <input
                type="number"
                name="quantity"
                min="0"
                max={MAX_STOCK}
                required
                value={levels[p.id] ?? 0}
                aria-label={`Stock for ${p.title}`}
                aria-invalid={invalid === p.id ? 'true' : undefined}
                aria-describedby={invalid === p.id ? `err-${p.id}` : undefined}
              />
              <button class="btn btn--accent" type="submit">Save</button>
              {saved === p.id && <span role="status">Saved.</span>}
              {invalid === p.id && (
                <span class="form-error" id={`err-${p.id}`} role="alert">Not saved: enter a whole number from 0 to 100,000.</span>
              )}
            </form>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
