---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPagination from '../../components/admin/AdminPagination.astro';
import { formatPrice, formatSofiaDateTime } from '../../lib/format';
import { formatBgPhone } from '../../lib/checkout-input';
import { parsePage } from '../../lib/catalog';
import {
  changeStatus,
  getOrder,
  itemTitle,
  listOrdersPage,
  ORDER_STATUSES,
  ORDERS_PAGE_SIZE,
  OutOfStockError,
  setInternalNote,
  StatusConflictError,
  type OrderStatus,
} from '../../lib/orders';

export const prerender = false;

const statusLabel: Record<OrderStatus, string> = {
  new: 'New (to confirm)',
  confirmed: 'Confirmed',
  shipped: 'Shipped',
  delivered: 'Delivered',
  cancelled: 'Cancelled',
  refused: 'Refused (COD)',
};
const isStatus = (s: unknown): s is OrderStatus => ORDER_STATUSES.includes(s as OrderStatus);

const filter = Astro.url.searchParams.get('status');
const status = isStatus(filter) ? filter : undefined;

// Save one order's status and note, then redirect back (so a refresh doesn't resubmit).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const expected = form.get('expected');
  const next = form.get('status');
  const note = String(form.get('note') ?? '').slice(0, 2000);
  let msg = 'saved';
  const order = Number.isInteger(id) ? await getOrder(env.DB, id) : null;
  if (!order || !isStatus(expected) || !isStatus(next)) {
    msg = 'invalid';
  } else {
    try {
      await changeStatus(env.DB, id, expected, next);
      if (note !== order.internalNote) await setInternalNote(env.DB, id, note);
    } catch (e) {
      if (e instanceof StatusConflictError) msg = 'conflict';
      else if (e instanceof OutOfStockError) msg = 'stock';
      else throw e;
    }
  }
  const back = new URL(Astro.url);
  back.searchParams.set('msg', msg);
  back.hash = `order-${id}`;
  return Astro.redirect(back.pathname + back.search + back.hash, 303);
}

const messages: Record<string, string> = {
  saved: 'Saved.',
  invalid: 'Invalid request.',
  conflict: 'This order was changed in the meantime (for example in another tab). Nothing was saved; check its current status.',
  stock: 'Not enough stock to move this order back to an active status. Nothing was saved.',
};
const msg = messages[Astro.url.searchParams.get('msg') ?? ''];

// The list's own URL for page n, keeping the status filter. Page 1 has no ?page=.
const pageHref = (n: number) => {
  const params = new URLSearchParams();
  if (status) params.set('status', status);
  if (n > 1) params.set('page', String(n));
  const query = params.toString();
  return query ? `/admin/?${query}` : '/admin/';
};
// A malformed ?page= goes to page 1, a page past the end to the last page.
const page = parsePage(Astro.url.searchParams.get('page'));
if (page === null) return Astro.redirect(pageHref(1), 303);
const { orders, total, pages } = await listOrdersPage(env.DB, { status, page });
if (page > pages) return Astro.redirect(pageHref(pages), 303);
const from = (page - 1) * ORDERS_PAGE_SIZE + 1;
const to = from + orders.length - 1;
// Sofia time, day/month order (see formatSofiaDateTime for why not Intl).
const when = formatSofiaDateTime;
---
<AdminLayout title="Orders" active="orders">
  <h1 class="page-h1">Orders</h1>
  <nav class="chips" aria-label="Filter by status">
    <a class="chip" href="/admin/" aria-current={!status ? 'page' : undefined}>All</a>
    {ORDER_STATUSES.map((s) => (
      <a class="chip" href={`/admin/?status=${s}`} aria-current={status === s ? 'page' : undefined}>{statusLabel[s]}</a>
    ))}
  </nav>
  {msg && <p class="admin-msg" role="status">{msg}</p>}
  {orders.length === 0 && <p style="margin-top: 24px">No orders.</p>}
  {total > 0 && <p class="muted" style="margin-top: 16px">Showing {from}–{to} of {total}</p>}
  <ol class="orders">
    {orders.map((o) => (
      <li class="order" id={`order-${o.id}`} data-status={o.status}>
        <div class="order__head">
          <strong>{o.reference}</strong>
          <span class="badge">{statusLabel[o.status]}</span>
          <span class="muted">{when(o.createdAt)}</span>
          <strong class="order__total">{formatPrice(o.totalCents)}</strong>
        </div>
        <div class="order__body">
          <div>
            <div>{o.customerName}</div>
            <a class="tel" href={`tel:${o.phone}`}>{formatBgPhone(o.phone)}</a>
            {o.email && <div><a href={`mailto:${o.email}`}>{o.email}</a></div>}
            <div>{o.deliveryMethod === 'office' ? 'Courier office' : 'Address'}: {o.city}, {o.deliveryDetails}</div>
            <div>{o.paymentMethod === 'cod' ? 'Cash on delivery' : 'Bank transfer'}</div>
            {o.customerNote && <div class="order__note">Customer note: {o.customerNote}</div>}
          </div>
          <ul class="order__items">
            {o.items.map((i) => <li>{i.quantity} × {itemTitle(i)} — {formatPrice(i.unitPriceCents * i.quantity)}</li>)}
          </ul>
        </div>
        <form method="post" class="order__form">
          <input type="hidden" name="id" value={o.id} />
          <input type="hidden" name="expected" value={o.status} />
          <label>
            Status
            <select name="status">
              {ORDER_STATUSES.map((s) => <option value={s} selected={s === o.status}>{statusLabel[s]}</option>)}
            </select>
          </label>
          <label class="order__internal">
            Internal note (the customer never sees it)
            <textarea name="note" maxlength="2000">{o.internalNote}</textarea>
          </label>
          <button class="btn btn--accent" type="submit">Save</button>
        </form>
      </li>
    ))}
  </ol>
  <AdminPagination page={page} pages={pages} href={pageHref} label="Order pages" />
</AdminLayout>
