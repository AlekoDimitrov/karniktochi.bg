---
import Layout from '../layouts/Layout.astro';
import { bg } from '../i18n/bg';

// Rendered per request: unknown paths, and pages that rewrite here (a removed product, a page number past
// the last one, an unknown category). Always a 404, so it is never cached (see cache-policy.ts).
export const prerender = false;

Astro.response.status = 404;
const t = bg.notFound;
---
<Layout title={`${t.title} — ${bg.siteName}`}>
  <div class="container narrow">
    <h1 class="page-h1">{t.title}</h1>
    <p>{t.text}</p>
    <p style="display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 24px">
      <a class="btn btn--accent" href="/produkti/">{t.shop}</a>
      <a class="link-orange" href="/" style="align-self: center">{t.home} →</a>
    </p>
  </div>
</Layout>
