---
import { Image } from 'astro:assets';
import { bg } from '../i18n/bg';
import { formatPrice } from '../lib/format';
import type { Product } from '../lib/products';

interface Props { product: Product }
const { product } = Astro.props;
const d = product.data;
const img = d.images[0];
---
<a class="card" href={`/produkti/${product.id}/`} data-product-id={product.id}>
  <div class="card__photo">
    {d.placeholder && <span class="ribbon">{bg.product.demo}</span>}
    {
      img ? (
        <Image src={img} alt={d.name} widths={[320, 480, 640]} sizes="(min-width: 1000px) 266px, 50vw" />
      ) : (
        <span>{bg.product.photo}, 4:5</span>
      )
    }
  </div>
  <div class="card__meta">
    <span class="card__brand">{d.brand.toUpperCase()}</span>
    <span class="card__name">{d.name}</span>
    <span class="card__price">
      {formatPrice(d.priceCents)}
      <span class="sold-out" data-sold-out hidden={d.stock > 0}> · {bg.product.outOfStock}</span>
    </span>
  </div>
</a>

<script>
  import { liveStock } from '../scripts/live-stock';
  // Show or hide "Изчерпан" on every card according to live stock.
  liveStock().then((stock) => {
    if (!stock) return;
    document.querySelectorAll<HTMLElement>('[data-product-id]').forEach((card) => {
      const n = stock[card.dataset.productId!];
      const label = card.querySelector<HTMLElement>('[data-sold-out]');
      if (n !== undefined && label) label.hidden = n > 0;
    });
  });
</script>
