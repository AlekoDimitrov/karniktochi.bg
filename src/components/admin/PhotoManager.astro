---
// The Photos section of the admin edit page, below the product form (one HTML form can't hold another).
// Move, remove and alt text are plain forms posted to the edit page, so they work without JavaScript; with
// JavaScript, src/scripts/admin-photo-list.ts does them without reloading the page (remove with Undo, drag to
// reorder; docs/slice-4-plan.md). Adding photos needs JavaScript: src/scripts/admin-photos.ts resizes and
// encodes them in the browser and posts each one to /admin/products/{slug}/photos/.
import PhotoItem from './PhotoItem.astro';
import { MAX_PHOTOS } from '../../lib/photo-sizes';
import type { Photo } from '../../lib/photos';

interface Props {
  productId: string;
  productName: string;
  published: boolean;
  photos: Photo[];
  mediaBase: string;
  /** The photo whose removal is being confirmed (?confirm-photo=). */
  confirmId?: string | null;
  /** The result of the last photo action, shown at the top of the section. */
  notice?: string;
  problem?: string;
}

const { productId, productName, published, photos, mediaBase, confirmId, notice, problem } = Astro.props;
const self = `/admin/products/${productId}/`;
---
<section class="pf-section pf-photos" id="photos" aria-labelledby="photos-title" data-photos data-product={productId} data-media-base={mediaBase} data-count={photos.length}>
  <div class="ph-head">
    <h2 id="photos-title" tabindex="-1">Photos</h2>
    <span class="muted" data-photo-count>{photos.length} of {MAX_PHOTOS}</span>
  </div>

  {notice && <p class="admin-msg ph-msg" role="status">{notice}</p>}
  {problem && <p class="admin-msg admin-msg--error ph-msg" role="alert">{problem} <a href={`${self}#photos`}>Reload</a></p>}

  {published && (
    <p class="admin-msg admin-msg--warn" data-photo-warning hidden={photos.length > 0}>Published without photos: customers see a placeholder.</p>
  )}
  <p class="admin-msg ph-msg" data-photo-status role="status" hidden></p>
  <p class="admin-msg admin-msg--error ph-msg" data-photo-error role="alert" hidden></p>

  <p class="muted ph-nojs" data-photo-nojs>Adding photos needs JavaScript. Moving, removing and alt text work without it.</p>

  <div class="ph-drop" data-photo-drop hidden>
    <p class="ph-drop__text">
      <strong>Drop photos here</strong>, or{' '}
      <label class="ph-drop__pick">
        choose files
        <input class="visually-hidden" type="file" accept="image/*" multiple data-photo-input />
      </label>
    </p>
    <p class="muted ph-drop__hint">
      They are resized in your browser to 400, 900 and 1800 px and uploaded one at a time, after the existing
      photos. At most {MAX_PHOTOS} photos; each at least 400 px on its long side.
    </p>
    <p class="muted ph-drop__full" data-photo-full hidden>This product has {MAX_PHOTOS} photos, the most it can have. Remove one to add another.</p>
  </div>

  <ol class="ph-queue" data-photo-queue aria-live="polite"></ol>

  <ul class="ph-undo" data-photo-undo></ul>

  <ol class="ph-list" data-photo-list>
    {photos.map((p, i) => (
      <PhotoItem photo={p} index={i} total={photos.length} self={self} productName={productName} mediaBase={mediaBase} confirm={confirmId === p.id} />
    ))}
  </ol>
  <template data-photo-template>
    <PhotoItem photo={null} index={0} total={1} self={self} productName={productName} mediaBase={mediaBase} />
  </template>
</section>

<script>
  import { enhancePhotos } from '../../scripts/admin-photos';
  enhancePhotos(document.querySelector<HTMLElement>('[data-photos]'));
</script>
