---
import { bg } from '../i18n/bg';

// Beak geometry in duck.webp's 600×600 pixels, measured from the image. The seam between the beak's
// halves is a curve y = seam(x), about 7 px thick; the outline around the beak is about 8 px.
const seam = (x: number) => 0.000521101 * x * x - 0.395273 * x + 283.304;
// Teeth hang from the seam (the upper beak's edge), turned to follow its slope.
const teeth = Array.from({ length: 8 }, (_, i) => {
  const cx = 306 + (i - 3.5) * 13;
  const cy = seam(cx);
  const slope = (Math.atan(2 * 0.000521101 * cx - 0.395273) * 180) / Math.PI;
  return { x: cx - 6, y: cy - 0.5, cx, cy, rot: slope.toFixed(2) };
});
---
<div class="bubble-wrap">
  <div class="bubble" data-bubble>
    <div class="bubble__duck" data-duck>
      <img src="/images/duck.webp" alt={bg.hero.duckAlt} width="600" height="600" />
      <!-- Eye overlay in the image's 600×600 pixel space: yellow patches hide the drawn eyes, so these can blink. -->
      <svg class="bubble__eyes" data-eyes viewBox="0 0 600 600" aria-hidden="true">
        <ellipse cx="185.5" cy="172.5" rx="24" ry="32" fill="#fff800" />
        <ellipse cx="414" cy="167.5" rx="24" ry="31" fill="#fff800" />
        <g class="bubble__eyes-open">
          <ellipse data-eye="0" cx="185.5" cy="172.5" rx="20" ry="27.5" />
          <ellipse data-eye="1" cx="414" cy="167.5" rx="20" ry="26.5" />
        </g>
        <g class="bubble__eyes-shut">
          <rect x="167" y="170" width="37" height="7" rx="3.5" />
          <rect x="395.5" y="165" width="37" height="7" rx="3.5" />
        </g>
        <!-- Grin (src/scripts/bubble.ts): happy-arc winks, then the beak opens. -->
        <path class="bubble__wink" data-wink="0" d="M167 180Q185.5 156 204 180" />
        <path class="bubble__wink" data-wink="1" d="M395.5 175Q414 151 432.5 175" />
        <g class="bubble__grin" data-grin>
          <defs>
            <!-- Lower half of the beak with its outline, from the seam's centre line down. -->
            <clipPath id="duck-jaw-clip">
              <path d="M204 222.5 210 223.3 216 222.2 222 221.2 228 220.3 234 219.3 240 218.5 246 217.6 252 216.8 258 216 264 215.3 270 214.6 276 213.9 282 213.3 288 212.7 294 212.1 300 211.6 306 211.1 312 210.7 318 210.3 324 209.9 330 209.6 336 209.3 342 209.1 348 208.9 354 208.7 360 208.5 366 208.4 372 208.4 378 208.3 384 208.4 390 208.4 396 208.5 402 208.6 407.5 216 407.5 220.5 402 233.5 396 240.5 390 245.5 384 249.5 378 252.5 372 255.5 366 257.5 360 259.5 354 261.5 348 262.5 342 263.5 336 264.5 330 266.5 324 267.5 318 267.5 312 268.5 306 268.5 300 268.5 294 268.5 288 268.5 282 267.5 276 266.5 270 266.5 264 265.5 258 264.5 252 262.5 246 261.5 240 258.5 234 256.5 228 253.5 222 250.5 216 244.5 210 238.5 206 231Z" />
            </clipPath>
            <radialGradient id="duck-glow">
              <stop offset="0" stop-color="#fffbe0" stop-opacity="0.9" />
              <stop offset="1" stop-color="#fffbe0" stop-opacity="0" />
            </radialGradient>
          </defs>
          <!-- Inside of the mouth: the orange part of the lower beak, so the outline at the corners stays. -->
          <path fill="#5b1d14" d="M215.5 221.8 221 221.4 227 220.4 233 219.5 239 218.6 245 217.7 251 216.9 257 216.1 263 215.4 269 214.7 275 214 281 213.4 287 212.8 293 212.2 299 211.7 305 211.2 311 210.8 317 210.4 323 210 329 209.7 335 209.4 341 209.1 347 208.9 353 208.7 359 208.6 365 208.5 371 208.4 377 208.3 383 208.4 389 208.4 395 212 399.5 215 398 222.5 395 229.5 389 237.5 383 242.5 377 246.5 371 248.5 365 251.5 359 253.5 353 255.5 347 256.5 341 257.5 335 259.5 329 259.5 323 260.5 317 261.5 311 261.5 305 261.5 299 260.5 293 260.5 287 259.5 281 259.5 275 258.5 269 257.5 263 255.5 257 254.5 251 252.5 245 250.5 239 248.5 233 244.5 227 241.5 221 237.5 216 232Z" />
          <g class="bubble__teeth">
            {teeth.map((t) => (
              <rect data-tooth={`${t.cx.toFixed(1)} ${(t.cy + 5).toFixed(1)}`} x={t.x.toFixed(1)} y={t.y.toFixed(1)} width="12" height="8.5" rx="3.5" transform={`rotate(${t.rot} ${t.cx.toFixed(1)} ${t.cy.toFixed(1)})`} />
            ))}
          </g>
          <!-- The lower beak: a copy of the image clipped to it, which drops to open the mouth. -->
          <g class="bubble__jaw" data-jaw>
            <image href="/images/duck.webp" width="600" height="600" clip-path="url(#duck-jaw-clip)" />
          </g>
          <!-- Sparkle on a tooth; the script moves it to the chosen tooth. -->
          <circle class="bubble__glow" data-glow r="38" fill="url(#duck-glow)" />
          <path class="bubble__spark" data-spark d="M0-28Q4-4 28 0Q4 4 0 28Q-4 4-28 0Q-4-4 0-28Z" />
          <circle class="bubble__spark" data-twinkle r="5.5" />
          <circle class="bubble__spark" data-twinkle r="4" />
          <circle class="bubble__spark" data-twinkle r="5" />
        </g>
      </svg>
    </div>
    <!-- Ripple rings are added by the script (TUNING.rippleMax). -->
    <div class="bubble__ripples" data-ripples aria-hidden="true"></div>
    <div class="bubble__gloss bubble__gloss--a"></div>
    <div class="bubble__gloss bubble__gloss--b"></div>
  </div>
  <button
    type="button"
    class="bubble__toggle"
    data-bubble-toggle
    data-paused="false"
    aria-pressed="false"
    aria-label={bg.hero.pauseAnimation}
    data-label-pause={bg.hero.pauseAnimation}
    data-label-play={bg.hero.playAnimation}
  >
    <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
    <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
  </button>
</div>

<script>
  import { initBubble } from '../scripts/bubble';
  const bubble = document.querySelector<HTMLElement>('[data-bubble]');
  const duck = bubble?.querySelector<HTMLElement>('[data-duck]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-bubble-toggle]');
  if (bubble && duck) initBubble(bubble, duck, toggle);
</script>
